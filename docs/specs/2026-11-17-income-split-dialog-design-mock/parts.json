  "matrix-row": { "mock": "[data-mock-part=matrix-row]", "real": "[class*=\"_mRow_\"]" },
  "mark": { "mock": "[data-mock-part=mark]", "real": "input:checked + [class*=\"_mark_\"]" },
  "legend": { "mock": "[data-mock-part=legend]", "real": "[class*=\"_legend_\"]" }
