  "pot-row": { "mock": "[data-mock-part=pot-row]", "real": "[class*=\"_potRow_\"]" },
  "cats": { "mock": "[data-mock-part=cats]", "real": "[class*=\"_split_\"] > section:nth-of-type(2)" },
  "cats-title": { "mock": "[data-mock-part=cats-title]", "real": "[class*=\"_split_\"] > section:nth-of-type(2) > [class*=\"_blockHead_\"] > span:nth-child(1)" },
  "cats-status": { "mock": "[data-mock-part=cats-status]", "real": "[class*=\"_split_\"] > section:nth-of-type(2) > [class*=\"_blockHead_\"] > span:nth-child(2)" },
