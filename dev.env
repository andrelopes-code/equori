# Local development environment, read by make dev. Load it into a shell with: set -a; . ./dev.env; set +a
EQUORI_DATABASE_URL=postgres://equori:equori@127.0.0.1:${EQUORI_DEV_DB_PORT:-54329}/equori?sslmode=disable
EQUORI_API_DOCS=true
# make dev serves plain HTTP; browsers drop Secure cookies on any origin other than localhost and 127.0.0.1 (ADR 003).
EQUORI_INSECURE_COOKIES=true
# Pages on the application's port redirect to the Vite server of make web-dev on this port of the same host; the API stays on the application's port (ADR 028 W14).
EQUORI_WEB_DEV_PORT=5173
