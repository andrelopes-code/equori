# equori: variables of compose.yaml, read from .env in this directory.
# Reference: https://github.com/andrelopes-code/equori/blob/main/docs/install/configuration.md
# The installation script writes POSTGRES_PASSWORD, EQUORI_PORT and EQUORI_SECRET_KEY.

# Password of the database user of compose.yaml. PostgreSQL reads it only when it creates the pgdata volume; a later change needs the same change inside the database. Expected: letters A to Z, a to z and digits 0 to 9. Default: equori.
POSTGRES_PASSWORD=

# Port of the host on which compose.yaml publishes equori. The installation script writes the first free port from 8080 to 8099. Expected: a port from 1 to 65535. Default: 8080.
EQUORI_PORT=

# Address of the host on which compose.yaml publishes equori. 0.0.0.0 opens it to the network, which over plain HTTP also needs EQUORI_INSECURE_COOKIES=true (docs/operations/remote-access.md). Expected: an IP address. Default: 127.0.0.1.
# EQUORI_HOST_IP=127.0.0.1

# Host folder that receives the encrypted copies of the backups. The container user, uid 999, writes into it. Expected: a directory path. Default: ./copies.
# EQUORI_COPY_FOLDER=./copies

# Key that seals the bank credentials, the second factor and the copy password (ADR 008); openssl rand -base64 32 writes one. Unset in external mode, those features are unavailable; managed mode writes secret.key. A new key makes the stored credentials unreadable, so a copy of .env stays apart from the backups. Expected: 32 bytes in standard base64.
EQUORI_SECRET_KEY=

# The replaced key during a rotation: set it, run equori secrets rotate, then remove it. Expected: 32 bytes in standard base64.
# EQUORI_SECRET_KEY_PREVIOUS=

# Lowest level of the records equori writes. Expected: debug, info, warn or error. Default: info.
# EQUORI_LOG_LEVEL=info

# true drops the Secure attribute of the session cookie, which a login over plain HTTP from another host needs (ADR 003). Expected: true or false. Default: false.
# EQUORI_INSECURE_COOKIES=false

# true serves the API reference at /docs and the contract at /openapi.yaml, both without a session. Expected: true or false. Default: false.
# EQUORI_API_DOCS=false
