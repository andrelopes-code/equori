[
  {
    "name": "get_account_history",
    "description": "Returns the daily balance of an account and its sub-accounts over a period, or its booked inflow and outflow per day. Use it for how a balance evolved or how much entered and left an account. Do not use it for a balance at one date: get_balances does; nor for the future: project_balance does.",
    "effect": "read_only",
    "idempotent": false,
    "input_schema": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string",
          "description": "account from list_accounts"
        },
        "view": {
          "type": "string",
          "description": "balances gives the balance each day; flows gives inflow and outflow each day with postings",
          "enum": [
            "balances",
            "flows"
          ]
        },
        "from": {
          "type": "string",
          "description": "first date, inclusive",
          "format": "date"
        },
        "to": {
          "type": "string",
          "description": "last date, inclusive; at most 366 days after from",
          "format": "date"
        }
      },
      "required": [
        "account_id",
        "view",
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string"
        },
        "account_name": {
          "type": "string"
        },
        "currency": {
          "type": "string",
          "description": "currency or instrument code of the account"
        },
        "view": {
          "type": "string"
        },
        "granularity": {
          "type": "string",
          "description": "day lists every day; week, for periods over 92 days, lists each Sunday and the last day"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "balance": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "string",
                    "description": "decimal amount in the instrument's scale, such as -1234.56"
                  },
                  "currency": {
                    "type": "string",
                    "description": "currency or instrument code"
                  }
                },
                "required": [
                  "amount",
                  "currency"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "date",
              "balance"
            ],
            "additionalProperties": false
          }
        },
        "days": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "inflow": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "string",
                    "description": "decimal amount in the instrument's scale, such as -1234.56"
                  },
                  "currency": {
                    "type": "string",
                    "description": "currency or instrument code"
                  }
                },
                "required": [
                  "amount",
                  "currency"
                ],
                "additionalProperties": false
              },
              "outflow": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "string",
                    "description": "decimal amount in the instrument's scale, such as -1234.56"
                  },
                  "currency": {
                    "type": "string",
                    "description": "currency or instrument code"
                  }
                },
                "required": [
                  "amount",
                  "currency"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "date",
              "inflow",
              "outflow"
            ],
            "additionalProperties": false
          },
          "description": "only days with postings"
        }
      },
      "required": [
        "account_id",
        "account_name",
        "currency",
        "view"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "get_balances",
    "description": "Returns the balance of every asset, liability and equity account at a date, by class and then account name; accounts with a zero balance are omitted. Use it for how much is in accounts, cards owed or net position at a date. Do not use it for spending by category: get_category_totals returns it; nor for a balance over time: get_account_history returns it.",
    "effect": "read_only",
    "idempotent": false,
    "input_schema": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "description": "balances at the end of this date; today when absent",
          "format": "date"
        },
        "basis": {
          "type": "string",
          "description": "booked places a posting at the transaction date, settled at the institution's settlement date; booked when absent",
          "enum": [
            "booked",
            "settled"
          ]
        },
        "class": {
          "type": "string",
          "description": "keep only accounts of this class",
          "enum": [
            "asset",
            "liability",
            "equity"
          ]
        },
        "limit": {
          "type": "integer",
          "description": "items per page, 1 to 50; 20 when absent"
        },
        "cursor": {
          "type": "string",
          "description": "next_cursor of the previous page; absent for the first page"
        }
      },
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "basis": {
          "type": "string"
        },
        "balances": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "account_id": {
                "type": "string"
              },
              "account_name": {
                "type": "string"
              },
              "class": {
                "type": "string"
              },
              "balance": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "string",
                    "description": "decimal amount in the instrument's scale, such as -1234.56"
                  },
                  "currency": {
                    "type": "string",
                    "description": "currency or instrument code"
                  }
                },
                "required": [
                  "amount",
                  "currency"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "account_id",
              "account_name",
              "class",
              "balance"
            ],
            "additionalProperties": false
          }
        },
        "next_cursor": {
          "type": "string",
          "description": "present when more balances follow; pass it as cursor"
        }
      },
      "required": [
        "date",
        "basis",
        "balances"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "get_category_totals",
    "description": "Totals the income or expense categories in a period, each with its own total and the total of its subtree, in category name order; only categories with postings and their ancestors are listed. Use it for how much was spent or earned by category. Do not use it for the transactions behind a total: search_transactions with account_id lists them.",
    "effect": "read_only",
    "idempotent": false,
    "input_schema": {
      "type": "object",
      "properties": {
        "class": {
          "type": "string",
          "description": "expense totals spending, income totals earnings; both are positive",
          "enum": [
            "income",
            "expense"
          ]
        },
        "from": {
          "type": "string",
          "description": "first date, inclusive",
          "format": "date"
        },
        "to": {
          "type": "string",
          "description": "last date, inclusive; at most 366 days after from",
          "format": "date"
        },
        "limit": {
          "type": "integer",
          "description": "items per page, 1 to 50; 20 when absent"
        },
        "cursor": {
          "type": "string",
          "description": "next_cursor of the previous page; absent for the first page"
        }
      },
      "required": [
        "class",
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "format": "date"
        },
        "to": {
          "type": "string",
          "format": "date"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "account_id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "parent_id": {
                "type": "string"
              },
              "parent_name": {
                "type": "string"
              },
              "total": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "string",
                    "description": "decimal amount in the instrument's scale, such as -1234.56"
                  },
                  "currency": {
                    "type": "string",
                    "description": "currency or instrument code"
                  }
                },
                "description": "postings on the category itself",
                "required": [
                  "amount",
                  "currency"
                ],
                "additionalProperties": false
              },
              "subtree_total": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "string",
                    "description": "decimal amount in the instrument's scale, such as -1234.56"
                  },
                  "currency": {
                    "type": "string",
                    "description": "currency or instrument code"
                  }
                },
                "description": "postings on the category and its descendants",
                "required": [
                  "amount",
                  "currency"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "account_id",
              "name",
              "total",
              "subtree_total"
            ],
            "additionalProperties": false
          }
        },
        "next_cursor": {
          "type": "string",
          "description": "present when more categories follow; pass it as cursor"
        }
      },
      "required": [
        "from",
        "to",
        "categories"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "list_accounts",
    "description": "Lists the user's accounts and categories by class and then name, with the IDs the other tools take, each account's institution, and the user's base currency. Income and expense accounts are the categories of transactions; a child account carries its parent. Use it to find the ID of an account or category named by the user. Do not use it for balances: get_balances returns them.",
    "effect": "read_only",
    "idempotent": false,
    "input_schema": {
      "type": "object",
      "properties": {
        "class": {
          "type": "string",
          "description": "keep only accounts of this class; income and expense accounts are the categories of transactions",
          "enum": [
            "asset",
            "liability",
            "equity",
            "income",
            "expense"
          ]
        },
        "include_closed": {
          "type": "boolean",
          "description": "also list closed accounts"
        },
        "limit": {
          "type": "integer",
          "description": "items per page, 1 to 50; 20 when absent"
        },
        "cursor": {
          "type": "string",
          "description": "next_cursor of the previous page; absent for the first page"
        }
      },
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "accounts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "class": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "description": "kind of an asset or liability account, such as checking or credit_card"
              },
              "currency": {
                "type": "string",
                "description": "currency or instrument code of the account"
              },
              "parent_id": {
                "type": "string"
              },
              "parent_name": {
                "type": "string"
              },
              "system_role": {
                "type": "string",
                "description": "set on accounts the ledger creates, such as uncategorized_expense"
              },
              "closed": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "name",
              "class",
              "currency"
            ],
            "additionalProperties": false
          }
        },
        "next_cursor": {
          "type": "string",
          "description": "present when more accounts follow; pass it as cursor"
        }
      },
      "required": [
        "accounts"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "search_transactions",
    "description": "Searches the user's transactions, newest first, with their payee, tags and postings; each posting names its account or category. Use it to find transactions by text, account, category, tag, period or missing category, and to get the transaction_id other tools take. Do not use it for totals by category: get_category_totals adds them up. Filters combine; narrow them instead of reading many pages.",
    "effect": "read_only",
    "idempotent": false,
    "input_schema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "case-insensitive text found in the description, the payee name or a posting memo"
        },
        "account_id": {
          "type": "string",
          "description": "keep transactions with a posting on this account or category; IDs come from list_accounts"
        },
        "tag": {
          "type": "string",
          "description": "keep transactions with this tag"
        },
        "from": {
          "type": "string",
          "description": "first date, inclusive",
          "format": "date"
        },
        "to": {
          "type": "string",
          "description": "last date, inclusive",
          "format": "date"
        },
        "uncategorized": {
          "type": "boolean",
          "description": "keep only transactions still waiting for a category"
        },
        "limit": {
          "type": "integer",
          "description": "items per page, 1 to 50; 20 when absent"
        },
        "cursor": {
          "type": "string",
          "description": "next_cursor of the previous page; absent for the first page"
        }
      },
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "transactions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "description": {
                "type": "string"
              },
              "payee_name": {
                "type": "string"
              },
              "voided": {
                "type": "boolean"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "postings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "account_id": {
                      "type": "string"
                    },
                    "account_name": {
                      "type": "string"
                    },
                    "account_class": {
                      "type": "string",
                      "description": "a posting on an income or expense account is the category of the transaction"
                    },
                    "amount": {
                      "type": "object",
                      "properties": {
                        "amount": {
                          "type": "string",
                          "description": "decimal amount in the instrument's scale, such as -1234.56"
                        },
                        "currency": {
                          "type": "string",
                          "description": "currency or instrument code"
                        }
                      },
                      "required": [
                        "amount",
                        "currency"
                      ],
                      "additionalProperties": false
                    },
                    "memo": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "account_id",
                    "account_name",
                    "account_class",
                    "amount"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "date",
              "description",
              "postings"
            ],
            "additionalProperties": false
          }
        },
        "next_cursor": {
          "type": "string",
          "description": "present when more transactions follow; pass it as cursor"
        }
      },
      "required": [
        "transactions"
      ],
      "additionalProperties": false
    }
  }
]
